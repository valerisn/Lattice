#!/usr/bin/env php
<?php
declare(strict_types=1);
if (PHP_SAPI !== 'cli') { http_response_code(404); exit; }
if (PHP_VERSION_ID < 80200) { fwrite(STDERR, "daemon requires PHP 8.2 or newer.\n"); exit(1); }
umask(0077);
require dirname(__DIR__) . '/autoload.php';
try {
    exit((new Lattice\Daemon\Application())->run(array_slice($argv, 1)));
} catch (Throwable $error) {
    $data = ['error' => $error->getMessage()];
    fwrite(STDERR, in_array('--json', $argv, true) ? json_encode($data, JSON_UNESCAPED_SLASHES) . "\n" : 'daemon: ' . $error->getMessage() . "\n");
    exit(1);
}

