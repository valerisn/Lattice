# Production requires PostgreSQL. Development without DATABASE_URL uses local PGlite.
# DATABASE_URL=postgresql://lattice:change-this-password@localhost:5432/lattice
APP_URL=http://localhost:3000
# Required for first-run setup on public installations. Use a long random value.
SETUP_TOKEN=
# For Docker Compose, set a unique database password before starting.
POSTGRES_PASSWORD=
UPLOAD_DIR=./uploads
